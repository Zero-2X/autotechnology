{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/media-visual-asset-set-version.schema.json",
  "title": "MediaVisualAssetSetVersion",
  "type": "object",
  "$defs": {
    "rights_snapshot": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      },
      "required": ["id", "snapshot_hash"],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "role": {"type": "string", "enum": ["cover", "thumbnail", "keyframe"]},
        "asset_version_id": {"type": "string", "format": "uuid"},
        "media_type": {"type": "string", "enum": ["image", "video", "thumbnail"]},
        "format": {"type": "string", "minLength": 1, "maxLength": 64},
        "storage_object_ref": {"anyOf": [{"type": "string", "pattern": "^private://", "minLength": 1}, {"type": "null"}]},
        "asset_snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "timestamp_ms": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "alt_text": {"type": "string", "minLength": 1, "maxLength": 500},
        "rights_record_version_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "rights_snapshots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rights_snapshot"}}
      },
      "required": [
        "sequence", "role", "asset_version_id", "media_type", "format", "storage_object_ref",
        "asset_snapshot_hash", "timestamp_ms", "alt_text", "rights_record_version_ids", "rights_snapshots"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "format": "uuid"},
    "media_visual_asset_set_id": {"type": "string", "format": "uuid"},
    "media_script_version_id": {"type": "string", "format": "uuid"},
    "media_storyboard_version_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "version_no": {"type": "integer", "minimum": 1},
    "duration_seconds": {"type": "integer", "enum": [30, 60, 90]},
    "region_profile_version_id": {"type": "string", "format": "uuid"},
    "policy_snapshot_id": {"type": "string", "format": "uuid"},
    "template_version": {"const": "media-visual-asset-set-v1"},
    "status": {"type": "string", "enum": ["draft", "edited", "in_review", "approved", "superseded", "withdrawn"]},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "item_count": {"type": "integer", "minimum": 1},
    "rights_snapshot_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "revision_reason": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "null"}]},
    "supersedes_version_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "source_script_snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_storyboard_snapshot_hash": {"anyOf": [{"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, {"type": "null"}]},
    "snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "created_by": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": [
    "id", "org_id", "media_visual_asset_set_id", "media_script_version_id", "media_storyboard_version_id",
    "version_no", "duration_seconds", "region_profile_version_id", "policy_snapshot_id", "template_version",
    "status", "items", "item_count", "rights_snapshot_ids", "revision_reason", "supersedes_version_id",
    "source_script_snapshot_hash", "source_storyboard_snapshot_hash", "snapshot_hash", "created_by", "created_at"
  ],
  "additionalProperties": false,
  "x-source": "MEDIA-003B",
  "x-append-only": true
}
