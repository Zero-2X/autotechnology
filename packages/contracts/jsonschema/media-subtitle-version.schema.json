{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/media-subtitle-version.schema.json",
  "title": "MediaSubtitleVersion",
  "type": "object",
  "$defs": {
    "accessibility": {
      "type": "object",
      "properties": {
        "captions_complete": {"type": "boolean"},
        "speaker_labels_complete": {"type": "boolean"},
        "sound_descriptions_complete": {"type": "boolean"},
        "reading_order": {"type": "string", "enum": ["chronological", "script_order"]},
        "max_lines": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_chars_per_line": {"type": "integer", "minimum": 1, "maximum": 80}
      },
      "required": [
        "captions_complete", "speaker_labels_complete", "sound_descriptions_complete",
        "reading_order", "max_lines", "max_chars_per_line"
      ],
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "source_segment_sequence": {"type": "integer", "enum": [1, 2, 3]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 250},
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "speaker_label": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 120}, {"type": "null"}]},
        "sound_description": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 240}, {"type": "null"}]},
        "is_forced": {"type": "boolean"},
        "line": {"type": "integer", "minimum": 0, "maximum": 100},
        "position": {"type": "integer", "minimum": 0, "maximum": 100},
        "align": {"type": "string", "enum": ["start", "center", "end"]}
      },
      "required": [
        "sequence", "source_segment_sequence", "start_ms", "end_ms", "text", "speaker_label",
        "sound_description", "is_forced", "line", "position", "align"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "locale": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{2,8})*$", "maxLength": 32},
        "language_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "kind": {"type": "string", "enum": ["caption", "subtitle"]},
        "direction": {"type": "string", "enum": ["ltr", "rtl"]},
        "is_default": {"type": "boolean"},
        "text_version": {"type": "integer", "minimum": 1},
        "source_text_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "cues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cue"}},
        "cue_count": {"type": "integer", "minimum": 1},
        "accessibility": {"$ref": "#/$defs/accessibility"}
      },
      "required": [
        "locale", "language_name", "kind", "direction", "is_default", "text_version", "source_text_hash",
        "cues", "cue_count", "accessibility"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "format": "uuid"},
    "media_subtitle_id": {"type": "string", "format": "uuid"},
    "media_script_version_id": {"type": "string", "format": "uuid"},
    "media_storyboard_version_id": {
      "anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]
    },
    "version_no": {"type": "integer", "minimum": 1},
    "duration_seconds": {"type": "integer", "enum": [30, 60, 90]},
    "policy_snapshot_id": {"type": "string", "format": "uuid"},
    "template_version": {"const": "media-subtitle-v1"},
    "status": {"type": "string", "enum": ["draft", "edited", "in_review", "approved", "superseded", "withdrawn"]},
    "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/track"}},
    "track_count": {"type": "integer", "minimum": 1},
    "accessibility": {"$ref": "#/$defs/accessibility"},
    "revision_reason": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "null"}]},
    "supersedes_version_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "source_script_snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_storyboard_snapshot_hash": {
      "anyOf": [{"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, {"type": "null"}]
    },
    "snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "created_by": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": [
    "id", "org_id", "media_subtitle_id", "media_script_version_id", "media_storyboard_version_id", "version_no",
    "duration_seconds", "policy_snapshot_id", "template_version", "status", "tracks", "track_count",
    "accessibility", "revision_reason", "supersedes_version_id", "source_script_snapshot_hash",
    "source_storyboard_snapshot_hash", "snapshot_hash", "created_by", "created_at"
  ],
  "additionalProperties": false,
  "x-source": "MEDIA-003A",
  "x-append-only": true
}
