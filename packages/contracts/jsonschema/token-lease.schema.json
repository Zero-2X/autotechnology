    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "account_connection_id",
    "secret_reference",
    "lease_version",
    "status",
    "expires_at",
    "created_at"
