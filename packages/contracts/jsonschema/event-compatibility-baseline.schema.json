{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/event-compatibility-baseline.schema.json",
  "title": "Event compatibility baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_key", "baseline_version", "registry", "event_count", "events", "compatibility"],
  "properties": {
    "baseline_key": {"const": "event-compatibility"},
    "baseline_version": {"const": 1},
    "registry": {"const": "docs/contracts/event-registry.yaml"},
    "event_count": {"type": "integer", "minimum": 1},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "compatibility": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
