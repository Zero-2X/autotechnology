{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/approved-model-provider.schema.json",
  "title": "ApprovedModelProvider",
  "type": "object",
  "properties": {
    "vendor_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "category": {"const": "model"},
    "selection_status": {"const": "approved"},
    "environment": {"type": "string", "enum": ["dev", "staging"]},
    "processing_regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "selected_data_region": {"type": "string", "minLength": 2},
    "retention_days": {"type": "integer", "minimum": 0},
    "contract_ref": {"type": "string", "minLength": 1},
    "dpa_ref": {"type": "string", "minLength": 1},
    "subprocessors_review_ref": {"type": "string", "minLength": 1},
    "exit_plan_ref": {"type": "string", "minLength": 1},
    "deletion_proof_ref": {"type": "string", "minLength": 1},
    "owner_approval_ref": {"type": "string", "minLength": 1},
    "terms_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "credential_ref_present": {"type": "boolean"},
    "max_timeout_ms": {"type": "integer", "minimum": 1},
    "max_cost_cents_per_call": {"type": "integer", "minimum": 0},
    "fallback_provider": {"const": "fake"},
    "status": {"const": "active"}
  },
  "required": ["vendor_id", "category", "selection_status", "environment", "processing_regions", "selected_data_region", "retention_days", "contract_ref", "dpa_ref", "subprocessors_review_ref", "exit_plan_ref", "deletion_proof_ref", "owner_approval_ref", "terms_version", "credential_ref_present", "max_timeout_ms", "max_cost_cents_per_call", "fallback_provider", "status"],
  "additionalProperties": false,
  "x-source": "MODEL-001 conditional dev/staging external provider evidence"
}
