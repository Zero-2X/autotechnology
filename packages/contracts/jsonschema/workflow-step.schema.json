{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/workflow-step.schema.json",
  "title": "workflow-step",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "step_key": {
      "type": "string",
      "minLength": 1
    },
    "step_no": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "workflow_run_id",
    "step_key",
    "step_no",
    "status",
    "input_hash",
    "created_at"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue"
}
