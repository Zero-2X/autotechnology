{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/distribution-target.schema.json",
  "title": "DistributionTarget",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "platform_id": {
      "type": "string",
      "format": "uuid"
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": [
        "article",
        "short_post",
        "video"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "retired"
      ]
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "retired_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "org_id",
    "platform_id",
    "market",
    "locale",
    "channel",
    "environment",
    "status",
    "created_by",
    "created_at",
    "retired_at"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue"
}
