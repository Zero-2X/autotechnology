{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/analytics-event-catalog.schema.json",
  "title": "AnalyticsEventCatalog",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_task": {
      "const": "ANALYTICS-001"
    },
    "categories": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "content",
              "asset",
              "publication",
              "interaction",
              "geo",
              "support",
              "qa",
              "cost",
              "risk"
            ]
          },
          "event_type": {
            "type": "string",
            "pattern": "^analytics\\.(content|asset|publication|interaction|geo|support|qa|cost|risk)\\.observed$"
          },
          "event_schema_ref": {
            "type": "string",
            "pattern": "^packages/contracts/events/analytics-[a-z]+-observed\\.schema\\.json$"
          },
          "allowed_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["site", "fake", "manual", "platform", "geo", "support", "qa"]
            }
          },
          "subject_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["publication", "content", "variant", "asset", "topic", "page", "geo_run"]
            }
          },
          "account_gated_sources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "const": "platform"
            }
          },
          "synthetic_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["fake", "manual"]
            }
          },
          "data_classification": {
            "const": "aggregate_only"
          },
          "dedupe_key": {
            "const": "event_id"
          },
          "ordering_key": {
            "const": "aggregate_id"
          }
        },
        "required": [
          "category",
          "event_type",
          "event_schema_ref",
          "allowed_sources",
          "subject_types",
          "account_gated_sources",
          "synthetic_sources",
          "data_classification",
          "dedupe_key",
          "ordering_key"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "source_task", "categories"],
  "additionalProperties": false
}
