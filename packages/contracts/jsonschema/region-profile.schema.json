{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/region-profile.schema.json",
  "title": "RegionProfile",
  "description": "Tenant-scoped region/market identity with an atomic pointer to its active immutable version.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "region_code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[A-Z]{2,8}(?:-[A-Z0-9]{2,8})*$"
    },
    "current_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "region_code",
    "current_version_id",
    "status",
    "created_at"
  ],
  "additionalProperties": false,
  "x-source": "GEO_REGION-001"
}
