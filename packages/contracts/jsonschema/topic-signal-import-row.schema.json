{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/topic-signal-import-row.schema.json",
  "title": "TopicSignalImportRow",
  "type": "object",
  "properties": {
    "source_type": {"type": "string", "enum": ["manual", "rss", "api", "import"]},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
    "captured_at": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
    "locale": {"type": "string", "minLength": 1, "maxLength": 64},
    "region": {"type": "string", "minLength": 1, "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "summary": {"type": "string", "minLength": 1, "maxLength": 8192},
    "usage_rights_status": {"type": "string", "enum": ["unknown", "verified", "restricted", "rejected"]},
    "terms_snapshot_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
    "license_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
    "permitted_use": {"type": "string", "enum": ["research", "editorial", "commercial", "none"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "required": ["source_type", "source_ref", "captured_at", "locale", "region", "title", "summary", "usage_rights_status", "terms_snapshot_ref", "license_ref", "permitted_use", "confidence"],
  "additionalProperties": false,
  "x-source": "TOPIC-002"
}
