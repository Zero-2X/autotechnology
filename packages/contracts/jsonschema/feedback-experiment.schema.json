{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/feedback-experiment.schema.json",
  "title": "FeedbackExperiment",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"}, "org_id": {"type": "string", "format": "uuid"}, "hypothesis": {"type": "string", "minLength": 1, "maxLength": 2000},
    "groups": {"type": "array", "minItems": 2, "items": {"type": "object", "properties": {"key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}, "label": {"type": "string", "minLength": 1}, "allocation_percent": {"type": "integer", "minimum": 1, "maximum": 100}}, "required": ["key", "label", "allocation_percent"], "additionalProperties": false}},
    "metric_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "window_start": {"type": "string", "format": "date-time"}, "window_end": {"type": "string", "format": "date-time"},
    "sample_target": {"type": "integer", "minimum": 1}, "status": {"type": "string", "enum": ["planned", "running", "concluded", "rolled_back"]},
    "conclusion": {"anyOf": [{"type": "object", "additionalProperties": false, "properties": {"winner": {"type": ["string", "null"]}, "summary": {"type": "string", "minLength": 1}, "metric_results": {"type": "object", "additionalProperties": true}}, "required": ["winner", "summary", "metric_results"]}, {"type": "null"}]},
    "rollback_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "version": {"type": "integer", "minimum": 1}, "created_by": {"type": "string", "format": "uuid"}, "created_at": {"type": "string", "format": "date-time"}
  },
  "required": ["id", "org_id", "hypothesis", "groups", "metric_keys", "window_start", "window_end", "sample_target", "status", "conclusion", "rollback_reason", "version", "created_by", "created_at"],
  "additionalProperties": false,
  "x-source": "FEEDBACK-EXP-001"
}
