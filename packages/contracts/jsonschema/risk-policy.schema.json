{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/risk-policy.schema.json",
  "title": "R0-R4 risk classification and escalation policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy_key": {"type": "string", "const": "risk-classification"},
    "policy_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["active", "superseded"]},
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "prefixItems": [
            {"const": "R0"}, {"const": "R1"}, {"const": "R2"}, {"const": "R3"}, {"const": "R4"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "direction": {"type": "string", "const": "increasing_severity"},
        "aggregation_rule": {"type": "string", "const": "highest_triggered_level_wins"},
        "unknown_floor": {"type": "string", "const": "R2"},
        "downgrade_rule": {"type": "string", "minLength": 1}
      },
      "required": ["order", "direction", "aggregation_rule", "unknown_floor", "downgrade_rule"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["content", "factuality", "rights", "account", "privacy", "security", "region_compliance", "platform", "runtime"]
      }
    },
    "cross_policy_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_levels": {"type": "string", "const": "release-levels/v1"},
        "raci": {"type": "string", "const": "raci-role-map/v1"}
      },
      "required": ["release_levels", "raci"]
    },
    "mandatory_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "R4", "all"]}
          },
          "requirement": {"type": "string", "minLength": 1}
        },
        "required": ["rule_id", "applies_to", "requirement"]
      }
    },
    "levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "risk_level": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"]},
          "display_name": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "triggers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "trigger_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "dimension": {
                  "type": "string",
                  "enum": ["content", "factuality", "rights", "account", "privacy", "security", "region_compliance", "platform", "runtime"]
                },
                "condition": {"type": "string", "minLength": 1}
              },
              "required": ["trigger_id", "dimension", "condition"]
            }
          },
          "allowed_automation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "blocked_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "human_escalation": {"type": "string", "enum": ["none", "conditional", "required", "incident_response"]},
          "minimum_approval_quorum": {"type": "integer", "minimum": 1, "maximum": 2},
          "response_sla_minutes": {"type": "integer", "minimum": 1},
          "primary_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "backup_roles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          },
          "kill_switch_requirement": {
            "type": "string",
            "enum": ["none", "conditional_scoped", "required_scoped", "immediate_scoped_or_global"]
          },
          "recovery_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rollback_rule": {"type": "string", "minLength": 1}
        },
        "required": [
          "risk_level", "display_name", "meaning", "triggers", "allowed_automation", "blocked_actions",
          "human_escalation", "minimum_approval_quorum", "response_sla_minutes", "primary_role", "backup_roles",
          "kill_switch_requirement", "recovery_requirements", "rollback_rule"
        ]
      }
    },
    "effective_at": {"type": "string", "format": "date-time"},
    "locked_by": {"type": "string", "minLength": 1}
  },
  "required": [
    "policy_key", "policy_version", "status", "scale", "dimensions", "cross_policy_refs",
    "mandatory_rules", "levels", "effective_at", "locked_by"
  ],
  "x-module": "governance",
  "x-task-ids": ["GOV-004"]
}
