{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/raci-policy.schema.json",
  "title": "RACI and incident responsibility policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy_key": {"type": "string", "const": "raci-role-map"},
    "policy_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["active", "superseded"]},
    "roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "role_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "display_name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "can_approve": {"type": "boolean"},
          "can_publish": {"type": "boolean"},
          "can_manage_credentials": {"type": "boolean"}
        },
        "required": ["role_key", "display_name", "purpose", "can_approve", "can_publish", "can_manage_credentials"]
      }
    },
    "raci_matrix": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "activity_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "responsible": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "accountable": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
          "consulted": {"type": "array", "items": {"type": "string"}},
          "informed": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["activity_key", "responsible", "accountable", "consulted", "informed"]
      }
    },
    "audit_responsibilities": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "audit_owner_role": {"type": "string"},
        "evidence_retention_days": {"type": "integer", "minimum": 1},
        "review_cadence": {"type": "string", "enum": ["weekly", "monthly", "quarterly"]},
        "independence_rule": {"type": "string", "minLength": 1}
      },
      "required": ["audit_owner_role", "evidence_retention_days", "review_cadence", "independence_rule"]
    },
    "incident_contacts": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "severity": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"]},
          "primary_role": {"type": "string"},
          "backup_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "response_sla_minutes": {"type": "integer", "minimum": 1},
          "escalation_trigger": {"type": "string", "minLength": 1}
        },
        "required": ["severity", "primary_role", "backup_roles", "response_sla_minutes", "escalation_trigger"]
      }
    },
    "effective_at": {"type": "string", "format": "date-time"},
    "locked_by": {"type": "string", "minLength": 1}
  },
  "required": ["policy_key", "policy_version", "status", "roles", "raci_matrix", "audit_responsibilities", "incident_contacts", "effective_at", "locked_by"],
  "x-module": "governance",
  "x-task-ids": ["GOV-003"]
}
