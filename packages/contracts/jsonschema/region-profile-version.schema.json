{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/region-profile-version.schema.json",
  "title": "RegionProfileVersion",
  "description": "Tenant-scoped versioned locale and market policy configuration.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "region_profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_no": {
      "type": "integer",
      "minimum": 1
    },
    "region_code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[A-Z]{2,8}(?:-[A-Z0-9]{2,8})*$"
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "date_number_format": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "units": {
      "type": "string",
      "enum": [
        "metric",
        "imperial",
        "mixed"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "terminology_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "disclosure_rules": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string", "minLength": 1, "maxLength": 512},
          {"type": "object", "minProperties": 1, "additionalProperties": true}
        ]
      },
      "uniqueItems": true
    },
    "restricted_topics": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string", "minLength": 1, "maxLength": 512},
          {"type": "object", "minProperties": 1, "additionalProperties": true}
        ]
      },
      "uniqueItems": true
    },
    "data_residency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "retention_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 36500
    },
    "deletion_sla_hours": {
      "type": "integer",
      "minimum": 0,
      "maximum": 87600
    },
    "platform_eligibility": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 128},
      "uniqueItems": true
    },
    "policy_snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_due_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "region_profile_id",
    "version_no",
    "region_code",
    "locales",
    "timezone",
    "date_number_format",
    "units",
    "currency",
    "terminology_version",
    "disclosure_rules",
    "restricted_topics",
    "data_residency",
    "retention_days",
    "deletion_sla_hours",
    "platform_eligibility",
    "policy_snapshot_id",
    "valid_from",
    "valid_to",
    "review_due_at",
    "status",
    "snapshot_hash",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false,
  "x-source": "GEO_REGION-001",
  "x-append-only": true
}
