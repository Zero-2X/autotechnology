{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/transform-output.schema.json",
  "title": "TransformOutput",
  "type": "object",
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "abstract": {"type": "string", "maxLength": 10000},
    "blocks": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "block_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "source_key": {"type": "string", "minLength": 1, "maxLength": 256},
          "localized_text": {"type": "string", "minLength": 1, "maxLength": 50000},
          "claim_id": {"type": ["string", "null"], "format": "uuid"},
          "disclosure": {"type": ["string", "null"], "maxLength": 4000}
        },
        "required": ["block_id", "source_key", "localized_text", "claim_id", "disclosure"],
        "additionalProperties": false
      }
    },
    "preservation_map": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "mapping_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "source_key": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {"type": "string", "enum": ["term", "number", "code", "link"]},
          "source_value": {"type": "string", "minLength": 1, "maxLength": 4000},
          "target_value": {"type": "string", "minLength": 1, "maxLength": 4000},
          "occurrence_count": {"type": "integer", "minimum": 1}
        },
        "required": ["mapping_key", "source_key", "kind", "source_value", "target_value", "occurrence_count"],
        "additionalProperties": false
      }
    },
    "transform_mode": {"const": "agent_candidate"},
    "needs_review": {"const": true}
  },
  "required": ["title", "abstract", "blocks", "preservation_map", "transform_mode", "needs_review"],
  "additionalProperties": false,
  "x-source": "AGENT-CORE-005D transient Variant draft candidate; no persistence or approval"
}
