{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/media-script-version.schema.json",
  "title": "MediaScriptVersion",
  "description": "Immutable 30, 60 or 90 second script with human-edit provenance and verified Claim references.",
  "type": "object",
  "$defs": {
    "segment": {
      "type": "object",
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 3},
        "kind": {"type": "string", "enum": ["hook", "body", "cta"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "claim_refs": {
          "type": "array",
          "items": {"type": "string", "format": "uuid"},
          "uniqueItems": true
        },
        "source_block_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256},
          "uniqueItems": true
        },
        "edit_origin": {"type": "string", "enum": ["template", "human"]}
      },
      "required": [
        "sequence", "kind", "start_ms", "end_ms", "text", "claim_refs",
        "source_block_ids", "edit_origin"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "format": "uuid"},
    "media_script_id": {"type": "string", "format": "uuid"},
    "variant_version_id": {"type": "string", "format": "uuid"},
    "version_no": {"type": "integer", "minimum": 1},
    "duration_seconds": {"type": "integer", "enum": [30, 60, 90]},
    "locale": {"type": "string", "minLength": 2, "maxLength": 64},
    "market": {"type": "string", "minLength": 1, "maxLength": 64},
    "region_profile_version_id": {"type": "string", "format": "uuid"},
    "policy_snapshot_id": {"type": "string", "format": "uuid"},
    "template_version": {"const": "media-script-v1"},
    "status": {"type": "string", "enum": ["draft", "edited", "in_review", "approved", "superseded", "withdrawn"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "segments": {
      "type": "array",
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/segment"}, {"properties": {"sequence": {"const": 1}, "kind": {"const": "hook"}}}]},
        {"allOf": [{"$ref": "#/$defs/segment"}, {"properties": {"sequence": {"const": 2}, "kind": {"const": "body"}}}]},
        {"allOf": [{"$ref": "#/$defs/segment"}, {"properties": {"sequence": {"const": 3}, "kind": {"const": "cta"}}}]}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "claim_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uuid"},
      "uniqueItems": true
    },
    "claim_snapshot_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {"type": "string", "format": "uuid"},
          "content_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        },
        "required": ["claim_id", "content_hash"],
        "additionalProperties": false
      }
    },
    "source_variant_snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "word_count": {"type": "integer", "minimum": 1},
    "estimated_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 90},
    "human_edited": {"type": "boolean"},
    "edit_reason": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 1000},
        {"type": "null"}
      ]
    },
    "supersedes_version_id": {
      "anyOf": [
        {"type": "string", "format": "uuid"},
        {"type": "null"}
      ]
    },
    "snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "created_by": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": [
    "id", "org_id", "media_script_id", "variant_version_id", "version_no",
    "duration_seconds", "locale", "market", "region_profile_version_id", "policy_snapshot_id",
    "template_version", "status", "title", "segments", "claim_refs", "claim_snapshot_hashes",
    "source_variant_snapshot_hash", "word_count", "estimated_duration_seconds", "human_edited",
    "edit_reason", "supersedes_version_id", "snapshot_hash", "created_by", "created_at"
  ],
  "additionalProperties": false,
  "x-source": "MEDIA-001",
  "x-append-only": true,
  "allOf": [
    {
      "if": {"properties": {"human_edited": {"const": false}}, "required": ["human_edited"]},
      "then": {"properties": {"edit_reason": {"type": "null"}, "status": {"const": "draft"}}}
    },
    {
      "if": {"properties": {"human_edited": {"const": true}}, "required": ["human_edited"]},
      "then": {
        "properties": {
          "edit_reason": {"type": "string", "minLength": 1},
          "status": {"enum": ["edited", "in_review", "approved", "superseded", "withdrawn"]}
        }
      }
    }
  ]
}
