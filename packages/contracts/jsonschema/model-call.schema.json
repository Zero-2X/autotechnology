{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/model-call.schema.json",
  "title": "redacted model call fact",
  "type": "object",
  "properties": {
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_minor": {"type": "integer", "minimum": 0},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "request_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": ["provider", "model", "input_tokens", "output_tokens", "cost_minor", "trace_id", "request_hash", "created_at"],
  "additionalProperties": false,
  "x-module": "orchestration",
  "x-task-ids": ["LC-MODEL-001", "GRAPH-OBS-001"]
}
