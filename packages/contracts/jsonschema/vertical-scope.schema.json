{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/vertical-scope.schema.json",
  "title": "locked vertical scope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "scope_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["locked", "superseded"]},
    "vertical_name": {"type": "string", "minLength": 1},
    "vertical_definition": {"type": "string", "minLength": 1},
    "primary_topics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "product_capabilities": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 1}},
    "languages": {"type": "array", "const": ["zh-CN", "en-US"]},
    "content_types": {"type": "array", "const": ["text"]},
    "knowledge_site": {"type": "string", "const": "first_party"},
    "distribution_modes": {"type": "array", "const": ["manual_export", "simulation"]},
    "account_strategy": {"type": "string", "const": "deferred_to_M2"},
    "initial_in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "initial_out_of_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "locked_at": {"type": "string", "format": "date-time"},
    "locked_by": {"type": "string", "minLength": 1}
  },
  "required": [
    "scope_key", "scope_version", "status", "vertical_name", "vertical_definition",
    "primary_topics", "product_capabilities", "languages", "content_types", "knowledge_site",
    "distribution_modes", "account_strategy", "initial_in_scope", "initial_out_of_scope",
    "locked_at", "locked_by"
  ],
  "allOf": [
    {"if": {"properties": {"status": {"const": "locked"}}}, "then": {"properties": {"scope_version": {"minimum": 1}}}}
  ],
  "x-module": "governance",
  "x-task-ids": ["GOV-001"]
}
