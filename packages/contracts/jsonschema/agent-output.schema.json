{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/agent-output.schema.json",
  "title": "agent-output",
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "status": {"type": "string", "enum": ["draft", "report", "needs_review"]},
    "result": {"type": "object", "properties": {"summary": {"type": "string", "minLength": 1}, "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "required": ["summary", "artifact_refs"], "additionalProperties": false},
    "issues": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object", "properties": {"limitations": {"type": "array", "items": {"type": "string"}}}, "required": ["limitations"], "additionalProperties": false}
  },
  "required": ["schema_version", "status", "result", "issues", "metadata"],
  "additionalProperties": false,
  "x-version-policy": "immutable-ref-with-explicit-forward-migration"
}
