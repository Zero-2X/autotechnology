{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/site-quality-report.schema.json",
  "title": "SiteQualityReport",
  "description": "Deterministic SITE-004 link, HTTP, performance, accessibility and dynamic-render audit projection.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "format": "uuid"},
    "site_page_version_id": {"type": "string", "format": "uuid"},
    "page_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https?://[^?#]+$"},
    "status": {"type": "string", "enum": ["passed", "blocked", "manual_review"]},
    "rule_version": {"type": "string", "const": "site-004.v1"},
    "threshold_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "input_snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_html_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "dynamic_html_hash": {
      "anyOf": [
        {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "lcp_ms": {"type": "number", "minimum": 0},
        "cls": {"type": "number", "minimum": 0},
        "inp_ms": {"type": "number", "minimum": 0},
        "ttfb_ms": {"type": "number", "minimum": 0},
        "max_total_bytes": {"type": "integer", "minimum": 1},
        "max_redirects": {"type": "integer", "minimum": 0, "maximum": 20}
      },
      "required": ["lcp_ms", "cls", "inp_ms", "ttfb_ms", "max_total_bytes", "max_redirects"],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "lcp_ms": {"type": ["number", "null"], "minimum": 0},
        "cls": {"type": ["number", "null"], "minimum": 0},
        "inp_ms": {"type": ["number", "null"], "minimum": 0},
        "ttfb_ms": {"type": ["number", "null"], "minimum": 0},
        "total_bytes": {"type": ["integer", "null"], "minimum": 0}
      },
      "required": ["lcp_ms", "cls", "inp_ms", "ttfb_ms", "total_bytes"],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "category": {"type": "string", "enum": ["http", "link", "redirect", "performance", "alt", "caption", "dynamic"]},
          "status": {"type": "string", "enum": ["pass", "fail", "review"]},
          "severity": {"type": "string", "enum": ["info", "warning", "error"]},
          "target": {"type": ["string", "null"], "maxLength": 2048},
          "observed": {},
          "expected": {},
          "message": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "required": ["code", "category", "status", "severity", "target", "observed", "expected", "message"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "category": {"type": "string", "enum": ["http", "link", "redirect", "performance", "alt", "caption", "dynamic"]},
          "severity": {"type": "string", "enum": ["warning", "error"]},
          "target": {"type": ["string", "null"], "maxLength": 2048},
          "message": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "required": ["code", "category", "severity", "target", "message"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "review": {"type": "integer", "minimum": 0}
      },
      "required": ["total", "passed", "failed", "review"],
      "additionalProperties": false
    },
    "request_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "report_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "minLength": 2, "maxLength": 200},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": [
    "id", "org_id", "site_page_version_id", "page_key", "canonical_url", "status", "rule_version", "threshold_version",
    "input_snapshot_hash", "source_html_hash", "dynamic_html_hash", "thresholds", "metrics", "checks",
    "findings", "summary", "request_hash", "report_hash", "idempotency_key", "evaluated_at",
    "actor_id", "trace_id", "created_at"
  ],
  "additionalProperties": false,
  "x-source": "SITE-004",
  "x-append-only": true
}
