{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/site-publication.schema.json",
  "title": "SitePublication",
  "type": "object",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "hreflang": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^(?:x-default|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["locale", "url"],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "html": {"$ref": "#/$defs/hash"},
        "sitemap": {"$ref": "#/$defs/hash"},
        "rss": {"$ref": "#/$defs/hash"},
        "atom": {"$ref": "#/$defs/hash"},
        "robots": {"$ref": "#/$defs/hash"}
      },
      "required": ["html", "sitemap", "rss", "atom", "robots"],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "format": "uuid"},
    "site_page_id": {"type": "string", "format": "uuid"},
    "site_page_version_id": {"type": "string", "format": "uuid"},
    "page_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]{1,127}$"
    },
    "version_no": {"type": "integer", "minimum": 1},
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "canonical_url": {"type": "string", "format": "uri"},
    "status": {"type": "string", "enum": ["rendered", "stale", "withdrawn"]},
    "snapshot_hash": {"$ref": "#/$defs/hash"},
    "renderer_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "request_hash": {"$ref": "#/$defs/hash"},
    "artifact_hashes": {"$ref": "#/$defs/artifacts"},
    "hreflang": {
      "type": "array",
      "items": {"$ref": "#/$defs/hreflang"},
      "uniqueItems": true
    },
    "x_default_locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "idempotency_key": {"type": "string", "minLength": 2, "maxLength": 200}
  },
  "required": [
    "id",
    "org_id",
    "site_page_id",
    "site_page_version_id",
    "page_key",
    "version_no",
    "locale",
    "canonical_url",
    "status",
    "snapshot_hash",
    "renderer_version",
    "request_hash",
    "artifact_hashes",
    "hreflang",
    "x_default_locale",
    "generated_at",
    "created_by",
    "created_at",
    "actor_id",
    "trace_id",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "x-source": "SITE-002 implementation contract"
}
