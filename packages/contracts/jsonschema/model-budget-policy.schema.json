{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/model-budget-policy.schema.json",
  "title": "Versioned model budget policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "org_id", "policy_key", "version_no", "status", "limits", "content_hash", "created_by", "created_at"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "minLength": 1},
    "policy_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "version_no": {"type": "integer", "minimum": 1},
    "status": {"const": "registered"},
    "limits": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "period", "key", "limit_cents"],
        "properties": {
          "scope": {"enum": ["org", "task", "model"]},
          "period": {"enum": ["task", "day", "month"]},
          "key": {"type": ["string", "null"], "minLength": 1},
          "limit_cents": {"type": "integer", "minimum": 1}
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "x-module": "model_gateway",
  "x-task-ids": ["MODEL-003"]
}
