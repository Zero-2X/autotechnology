{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/source-snapshot.schema.json",
  "title": "SourceSnapshot",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "storage_object_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^private://"
    },
    "terms_snapshot_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "captured",
        "quarantined",
        "usable",
        "expired",
        "revoked",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "source_id",
    "captured_at",
    "content_hash",
    "storage_object_ref",
    "terms_snapshot_ref",
    "confidence",
    "status",
    "created_at"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue"
}
