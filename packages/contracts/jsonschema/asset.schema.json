{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/asset.schema.json",
  "title": "Asset",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "variant_id": {
      "type": "string",
      "format": "uuid"
    },
    "current_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "withdrawn",
        "retired"
      ]
    }
  },
  "required": [
    "id",
    "org_id",
    "variant_id",
    "current_version_id",
    "status"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue"
}
