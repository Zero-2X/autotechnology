{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/geo-content-assessment.schema.json",
  "title": "GeoContentAssessment",
  "type": "object",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "dimension": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["pass", "review", "fail"]},
        "checked": {"type": "integer", "minimum": 0},
        "finding_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "required": ["status", "checked", "finding_codes"],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string",
          "enum": ["entity_consistency", "claim_traceability", "citation_readiness", "freshness", "crawlability"]
        },
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "severity": {"type": "string", "enum": ["error", "warning", "info"]},
        "subject_ref": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "related_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "required": ["dimension", "code", "severity", "subject_ref", "related_refs"],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "event_type": {"const": "geo_content.assessed"},
        "org_id": {"type": "string", "format": "uuid"},
        "actor_id": {"type": "string", "format": "uuid"},
        "trace_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "assessment_id": {"type": "string", "format": "uuid"},
        "rule_version": {"type": "string", "minLength": 1},
        "input_hash": {"$ref": "#/$defs/hash"},
        "output_hash": {"$ref": "#/$defs/hash"},
        "status": {"type": "string", "enum": ["pass", "review", "fail"]},
        "finding_count": {"type": "integer", "minimum": 0},
        "policy_snapshot_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "assessed_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0}
      },
      "required": ["event_type", "org_id", "actor_id", "trace_id", "assessment_id", "rule_version", "input_hash", "output_hash", "status", "finding_count", "policy_snapshot_hash", "assessed_at", "duration_ms"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "geo-content-001.v1"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "format": "uuid"},
    "actor_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "idempotency_key": {"type": "string", "minLength": 2, "maxLength": 200},
    "rule_version": {"type": "string", "const": "geo-content-001.v1"},
    "assessed_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["pass", "review", "fail"]},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "dimensions": {
      "type": "object",
      "properties": {
        "entity_consistency": {"$ref": "#/$defs/dimension"},
        "claim_traceability": {"$ref": "#/$defs/dimension"},
        "citation_readiness": {"$ref": "#/$defs/dimension"},
        "freshness": {"$ref": "#/$defs/dimension"},
        "crawlability": {"$ref": "#/$defs/dimension"}
      },
      "required": ["entity_consistency", "claim_traceability", "citation_readiness", "freshness", "crawlability"],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "input_hash": {"$ref": "#/$defs/hash"},
    "output_hash": {"$ref": "#/$defs/hash"},
    "policy_snapshot_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "eligible_for_crawl": {"type": "boolean"},
    "eligible_for_citation": {"type": "boolean"},
    "source_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "audit_evidence": {"$ref": "#/$defs/audit"}
  },
  "required": ["schema_version", "assessment_id", "org_id", "actor_id", "trace_id", "idempotency_key", "rule_version", "assessed_at", "status", "score", "dimensions", "findings", "input_hash", "output_hash", "policy_snapshot_hash", "eligible_for_crawl", "eligible_for_citation", "source_refs", "audit_evidence"],
  "additionalProperties": false,
  "x-source": "GEO_CONTENT-001 deterministic content readiness rules"
}
