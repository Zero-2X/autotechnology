{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/policy-decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_type": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_policy": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "manual_review"
      ]
    },
    "region_policy": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "manual_review"
      ]
    },
    "distribution_policy": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "manual_review"
      ]
    },
    "account_policy": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "unknown",
        "manual_review"
      ]
    },
    "data_processing_policy": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "manual_review"
      ]
    },
    "model_policy": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "manual_review"
      ]
    },
    "final_decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "manual_review"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "decision_version": {
      "type": "integer"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "subject_type",
    "subject_id",
    "content_policy",
    "region_policy",
    "distribution_policy",
    "account_policy",
    "data_processing_policy",
    "model_policy",
    "final_decision",
    "reasons",
    "policy_snapshot_id",
    "decision_hash",
    "decision_version",
    "evaluated_at",
    "expires_at",
    "created_at"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue"
}
