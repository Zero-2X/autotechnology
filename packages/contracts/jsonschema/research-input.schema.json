{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/research-input.schema.json",
  "title": "ResearchInput",
  "type": "object",
  "properties": {
    "research_request_id": {"type": "string", "format": "uuid"},
    "question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "source_snapshot_id": {"type": "string", "format": "uuid"},
          "content_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "excerpts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
                "quote": {"type": "string", "minLength": 1, "maxLength": 4000}
              },
              "required": ["locator", "quote"],
              "additionalProperties": false
            }
          }
        },
        "required": ["source_snapshot_id", "content_hash", "excerpts"],
        "additionalProperties": false
      }
    },
    "tool_calls": {"type": "array", "maxItems": 0}
  },
  "required": ["research_request_id", "question", "sources", "tool_calls"],
  "additionalProperties": false,
  "x-source": "AGENT-CORE-005B controlled research input"
}
