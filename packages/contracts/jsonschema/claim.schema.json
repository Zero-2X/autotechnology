{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "fact_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "applicable_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applicable_regions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applicable_locales": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_due_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_claim_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness_status": {
      "type": "string",
      "enum": [
        "fresh",
        "review_due",
        "stale",
        "withdrawn"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "withdrawn"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "entity_ids",
    "statement",
    "fact_type",
    "applicable_versions",
    "applicable_regions",
    "applicable_locales",
    "valid_from",
    "valid_to",
    "review_due_at",
    "supersedes_claim_id",
    "freshness_status",
    "status",
    "version",
    "content_hash",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue",
  "allOf": [
    {
      "if": {
        "properties": {
          "valid_from": {
            "type": "string"
          },
          "valid_to": {
            "type": "string"
          }
        },
        "required": [
          "valid_from",
          "valid_to"
        ]
      },
      "then": {
        "description": "valid_to must be later than valid_from; enforced by the use case"
      }
    }
  ]
}
