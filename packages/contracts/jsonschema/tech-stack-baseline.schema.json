{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/tech-stack-baseline.schema.json",
  "title": "Modular monolith and deployment technology baseline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "baseline_key": {"type": "string", "const": "modular-monolith"},
    "baseline_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["active", "superseded"]},
    "components": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "component_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "category": {"type": "string", "enum": ["runtime", "api", "worker", "orchestration", "model", "database", "migration", "object_storage", "observability", "testing"]},
          "technology": {"type": "string", "minLength": 1},
          "version_policy": {"type": "string", "minLength": 1},
          "environment": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["dev", "staging", "prod"]}},
          "required": {"type": "boolean"},
          "phase": {"type": "string", "enum": ["P0", "P1"]}
        },
        "required": ["component_key", "category", "technology", "version_policy", "environment", "required", "phase"]
      }
    },
    "excluded_initially": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "architecture_constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "upgrade_policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "regular_window_days": {"type": "integer", "minimum": 1},
        "security_fix_window_days": {"type": "integer", "minimum": 0},
        "owner_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["regular_window_days", "security_fix_window_days", "owner_role", "required_evidence"]
    },
    "effective_at": {"type": "string", "format": "date-time"},
    "locked_by": {"type": "string", "pattern": "^[a-z][a-z0-9_/.-]*$"}
  },
  "required": ["baseline_key", "baseline_version", "status", "components", "excluded_initially", "architecture_constraints", "upgrade_policy", "effective_at", "locked_by"],
  "x-module": "governance",
  "x-task-ids": ["GOV-006"]
}
