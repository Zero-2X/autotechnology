{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/rights-provenance-input.schema.json",
  "title": "RightsProvenanceInput",
  "type": "object",
  "properties": {
    "analysis_request_id": {"type": "string", "format": "uuid"},
    "rights_context": {
      "type": "object",
      "properties": {
        "rights_record_id": {"type": "string", "format": "uuid"},
        "rights_record_version_id": {"type": "string", "format": "uuid"},
        "version_no": {"type": "integer", "minimum": 1},
        "snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "source_snapshot_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "format": "uuid"}
        },
        "license_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
        "contract_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
        "evidence_object_refs": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "recorded_scope": {
          "type": "object",
          "properties": {
            "rights_holder": {"type": "string", "minLength": 1, "maxLength": 512},
            "permitted_regions": {"type": "array", "items": {"type": "string"}},
            "permitted_locales": {"type": "array", "items": {"type": "string"}},
            "permitted_media": {"type": "array", "items": {"type": "string"}},
            "permitted_use": {"type": "string", "enum": ["research", "derivative", "commercial"]},
            "valid_from": {"type": ["string", "null"], "format": "date-time"},
            "valid_to": {"type": ["string", "null"], "format": "date-time"},
            "policy_rule_version": {"type": "string", "minLength": 1, "maxLength": 256},
            "status": {"type": "string", "enum": ["pending", "verified", "expired", "revoked", "complaint_hold"]}
          },
          "required": ["rights_holder", "permitted_regions", "permitted_locales", "permitted_media", "permitted_use", "valid_from", "valid_to", "policy_rule_version", "status"],
          "additionalProperties": false
        }
      },
      "required": ["rights_record_id", "rights_record_version_id", "version_no", "snapshot_hash", "source_snapshot_ids", "license_ref", "contract_ref", "evidence_object_refs", "recorded_scope"],
      "additionalProperties": false
    },
    "evidence_excerpts": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
          "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
          "quote": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "required": ["evidence_ref", "locator", "quote"],
        "additionalProperties": false
      }
    },
    "tool_calls": {"type": "array", "maxItems": 0}
  },
  "required": ["analysis_request_id", "rights_context", "evidence_excerpts", "tool_calls"],
  "additionalProperties": false,
  "x-source": "AGENT-CORE-005C controlled rights evidence input"
}
