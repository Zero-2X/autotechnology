{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/lineage-query.schema.json",
  "title": "lineage-query",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_type": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "unavailable_stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "query_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  },
  "required": [
    "org_id",
    "subject_type",
    "subject_id",
    "nodes",
    "edges",
    "unavailable_stages",
    "query_hash"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue"
}
