    "approval_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "assigned",
        "claimed",
        "in_progress",
        "submitted",
        "completed",
        "escalated",
        "rejected",
        "expired",
        "cancelled"
      ]
    },
    "assigned_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
