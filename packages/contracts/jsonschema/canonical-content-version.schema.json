{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/canonical-content-version.schema.json",
  "title": "CanonicalContentVersion",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "canonical_content_id": {
      "type": "string",
      "format": "uuid"
    },
    "topic_brief_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_no": {
      "type": "integer"
    },
    "topic_brief_status": {
      "type": "string",
      "enum": [
        "locked",
        "approved"
      ]
    },
    "topic_brief_lock_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer"
          },
          "content": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer"
          },
          "claim_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "urgent"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "rights_snapshot_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "content": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "position",
          "priority",
          "evidence_ids",
          "rights_snapshot_ids"
        ],
        "additionalProperties": false
      }
    },
    "code_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer"
          },
          "content": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer"
          },
          "content": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer"
          },
          "content": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "source_snapshot_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "source_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "knowledge_core_version": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "knowledge_core_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_snapshot_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "rights_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "freshness_status": {
      "type": "string",
      "enum": [
        "fresh",
        "review_due",
        "stale",
        "expired",
        "conflict",
        "withdrawn"
      ]
    },
    "freshness_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "freshness_expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "conflict_set_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "refresh_required": {
      "type": "boolean"
    },
    "supersedes_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "evidence_pending",
        "fact_checked",
        "approved",
        "superseded",
        "withdrawn"
      ]
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "canonical_content_id",
    "topic_brief_id",
    "version_no",
    "topic_brief_status",
    "topic_brief_lock_hash",
    "title",
    "abstract",
    "sections",
    "claims",
    "code_blocks",
    "examples",
    "limitations",
    "source_snapshot_refs",
    "source_snapshot_ids",
    "knowledge_core_version",
    "knowledge_core_version_id",
    "input_snapshot_hash",
    "content_hash",
    "rights_snapshot_ids",
    "freshness_status",
    "freshness_checked_at",
    "freshness_expires_at",
    "conflict_set_ids",
    "refresh_required",
    "supersedes_version_id",
    "status",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue"
}
