{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/variant-draft.schema.json",
  "title": "VariantDraft",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "format": "uuid"},
    "canonical_content_id": {"type": "string", "format": "uuid"},
    "canonical_content_version_id": {"type": "string", "format": "uuid"},
    "source_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locale": {"type": "string", "minLength": 1},
    "market": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "tone": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "abstract": {"type": "string"},
    "blocks": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "source_key": {"type": "string", "minLength": 1},
        "source_text_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "localized_text": {"type": "string", "minLength": 1},
        "claim_id": {"type": ["string", "null"], "format": "uuid"},
        "disclosure": {"type": ["string", "null"]}
      },
      "required": ["block_id", "source_key", "source_text_hash", "localized_text", "claim_id", "disclosure"],
      "additionalProperties": false
    }},
    "status": {"const": "draft"},
    "needs_review": {"const": true},
    "transform_mode": {"type": "string", "minLength": 1},
    "draft_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_by": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": ["id", "org_id", "canonical_content_id", "canonical_content_version_id", "source_content_hash",
    "locale", "market", "audience", "tone", "title", "abstract", "blocks", "status", "needs_review",
    "transform_mode", "draft_hash", "created_by", "trace_id", "created_at"],
  "additionalProperties": false,
  "x-source": "PROD-001 transient transform draft; PROD-002 owns persistent VariantVersion"
}
