{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/qa-agent-output.schema.json",
  "title": "QAAgentOutput",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "finding_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "source_finding_index": {"type": "integer", "minimum": 0},
          "code": {"type": "string", "minLength": 1, "maxLength": 128},
          "severity": {"type": "string", "enum": ["info", "warning", "error"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 1000},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 4000},
          "observed": {},
          "expected": {}
        },
        "required": ["finding_key", "source_finding_index", "code", "severity", "path", "explanation", "observed", "expected"],
        "additionalProperties": false
      }
    },
    "human_tasks": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "task_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "task_type": {"const": "qa_review"},
          "priority": {"type": "string", "enum": ["low", "medium", "high", "urgent"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
          "finding_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}
        },
        "required": ["task_key", "task_type", "priority", "reason", "finding_keys"],
        "additionalProperties": false
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "needs_review": {"const": true},
    "decision": {"const": "review_only"},
    "approved": {"const": false},
    "published": {"const": false}
  },
  "required": ["findings", "human_tasks", "summary", "needs_review", "decision", "approved", "published"],
  "additionalProperties": false,
  "x-source": "AGENT-CORE-005E QA explanation only; no approval or publication"
}
