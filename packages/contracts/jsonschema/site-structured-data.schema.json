{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/site-structured-data.schema.json",
  "title": "SiteStructuredData",
  "type": "object",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "node": {
      "type": "object",
      "required": ["@type", "@id"],
      "properties": {
        "@type": {
          "anyOf": [
            {"type": "string", "enum": ["Article", "TechArticle", "Organization", "Person", "VideoObject"]},
            {"type": "array", "items": {"type": "string"}, "minItems": 1}
          ]
        },
        "@id": {"type": "string", "minLength": 1, "format": "uri-reference"}
      },
      "allOf": [
        {
          "if": {"properties": {"@type": {"enum": ["Article", "TechArticle"]}}},
          "then": {
            "required": ["headline", "url", "inLanguage", "dateModified", "author", "publisher", "articleBody"],
            "properties": {"articleBody": {"type": "string", "minLength": 1}}
          }
        },
        {
          "if": {"properties": {"@type": {"const": "Organization"}}},
          "then": {"required": ["name", "url"]}
        },
        {
          "if": {"properties": {"@type": {"const": "Person"}}},
          "then": {"required": ["name"]}
        },
        {
          "if": {"properties": {"@type": {"const": "VideoObject"}}},
          "then": {"required": ["name", "contentUrl", "uploadDate"]}
        }
      ],
      "additionalProperties": true
    },
    "jsonld": {
      "type": "object",
      "properties": {
        "@context": {"const": "https://schema.org"},
        "@graph": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/node"}
        }
      },
      "required": ["@context", "@graph"],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "site-003.v1"},
        "org_id": {"type": "string", "minLength": 1},
        "site_page_version_id": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "format": "uri"},
        "locale": {"type": "string"},
        "source_snapshot_hash": {"$ref": "#/$defs/hash"},
        "renderer_version": {"type": "string", "minLength": 1},
        "article_type": {"type": "string", "enum": ["Article", "TechArticle"]},
        "node_types": {"type": "array", "items": {"type": "string"}, "minItems": 3},
        "video_included": {"type": "boolean"},
        "generated_at": {"type": "string", "format": "date-time"},
        "request_hash": {"$ref": "#/$defs/hash"},
        "hash": {"$ref": "#/$defs/hash"}
      },
      "required": ["schema_version", "org_id", "site_page_version_id", "canonical_url", "locale", "source_snapshot_hash", "renderer_version", "article_type", "node_types", "video_included", "generated_at", "request_hash", "hash"],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "event_type": {"type": "string", "const": "site.structured_data.generated"},
        "org_id": {"type": "string", "minLength": 1},
        "actor_id": {"type": ["string", "null"]},
        "trace_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "input_version_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "source_snapshot_hash": {"$ref": "#/$defs/hash"},
        "request_hash": {"$ref": "#/$defs/hash"},
        "output_hash": {"$ref": "#/$defs/hash"},
        "renderer_version": {"type": "string", "minLength": 1},
        "policy_snapshot": {},
        "video_included": {"type": "boolean"},
        "status": {"const": "succeeded"},
        "generated_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "cost": {"type": "number", "minimum": 0}
      },
      "required": ["event_type", "org_id", "actor_id", "trace_id", "input_version_ids", "source_snapshot_hash", "request_hash", "output_hash", "renderer_version", "video_included", "status", "generated_at", "duration_ms", "cost"],
      "additionalProperties": true
    }
  },
  "properties": {
    "schema_version": {"const": "site-003.v1"},
    "org_id": {"type": "string", "minLength": 1},
    "site_page_version_id": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "source_snapshot_hash": {"$ref": "#/$defs/hash"},
    "renderer_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "article_type": {"type": "string", "enum": ["Article", "TechArticle"]},
    "video_included": {"type": "boolean"},
    "generated_at": {"type": "string", "format": "date-time"},
    "request_hash": {"$ref": "#/$defs/hash"},
    "hash": {"$ref": "#/$defs/hash"},
    "jsonld": {"$ref": "#/$defs/jsonld"},
    "jsonld_text": {"type": "string", "minLength": 1},
    "script": {"type": "string", "pattern": "^<script type=\"application/ld\\+json\">[\\s\\S]+</script>$"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "audit_evidence": {"$ref": "#/$defs/audit"}
  },
  "required": ["schema_version", "org_id", "site_page_version_id", "canonical_url", "locale", "source_snapshot_hash", "renderer_version", "article_type", "video_included", "generated_at", "request_hash", "hash", "jsonld", "jsonld_text", "script", "manifest", "audit_evidence"],
  "additionalProperties": false,
  "x-source": "SITE-003 implementation contract"
}
