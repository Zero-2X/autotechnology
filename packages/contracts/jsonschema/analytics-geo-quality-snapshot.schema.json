{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/analytics-geo-quality-snapshot.schema.json",
  "title": "AnalyticsGeoQualitySnapshot",
  "$defs": {
    "rate": {
      "type": "object",
      "properties": {"numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0}, "value": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]}},
      "required": ["numerator", "denominator", "value"], "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "properties": {"sample_count": {"type": "integer", "minimum": 0}, "metric_counts": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"}, "additionalProperties": {"$ref": "#/$defs/rate"}}},
      "required": ["sample_count", "metric_counts"], "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}, "scope": {"type": "string", "enum": ["content", "region", "all"]}, "count": {"type": "integer", "minimum": 0}},
      "required": ["code", "scope", "count"], "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"}, "org_id": {"type": "string", "format": "uuid"},
    "window_start": {"type": "string", "format": "date-time"}, "window_end": {"type": "string", "format": "date-time"},
    "region": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "locale": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "source_scope": {"type": "string", "enum": ["account_free", "all_verified"]}, "input_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "input_snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "content": {"$ref": "#/$defs/projection"}, "region_quality": {"$ref": "#/$defs/projection"},
    "status": {"type": "string", "enum": ["complete", "needs_review"]}, "quality_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}, "rule_version": {"const": "analytics-004.v1"},
    "snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "created_by": {"type": "string", "format": "uuid"}, "created_at": {"type": "string", "format": "date-time"}
  },
  "required": ["id", "org_id", "window_start", "window_end", "region", "locale", "source_scope", "input_observation_ids", "input_snapshot_hash", "content", "region_quality", "status", "quality_issues", "rule_version", "snapshot_hash", "created_by", "created_at"],
  "additionalProperties": false,
  "x-source": "ANALYTICS-004"
}
