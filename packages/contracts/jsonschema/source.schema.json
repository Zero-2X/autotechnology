{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-content-workflow.local/source.schema.json",
  "title": "Source",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "url",
        "file",
        "api",
        "manual",
        "support"
      ]
    },
    "fetch_method": {
      "type": "string",
      "enum": ["url", "file", "api", "manual", "support", "rss", "crawler", "upload"]
    },
    "canonical_url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "none",
        "ingested",
        "quarantined",
        "usable",
        "expired",
        "revoked",
        "blocked"
      ]
    },
    "current_snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "org_id",
    "source_type",
    "fetch_method",
    "canonical_url",
    "status",
    "current_snapshot_id",
    "confidence",
    "created_at"
  ],
  "additionalProperties": false,
  "x-source": "section-4.6-field-catalogue"
}
